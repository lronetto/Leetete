	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 600MB
	}

	reverse_proxy app:3000 {
		transport http {
			response_header_timeout 10m
			dial_timeout 30s
		}
	}
}

{$MEDIA_DOMAIN} {
	encode gzip
	reverse_proxy minio:9000 {
		header_up Host {upstream_hostport}
	}
}
